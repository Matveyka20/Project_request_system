# .env.example - Configuration template for Request System API
# Copy this file to .env and modify values as needed
# This file is for documentation and CI/CD defaults

# ============================================================================
# Environment & Server
# ============================================================================

# Application environment: development, staging, production
APP_ENV=development

# Enable debug mode (should be false in production)
APP_DEBUG=true

# API server port
APP_PORT=8000

# Host/IP to bind to (0.0.0.0 for all interfaces)
APP_HOST=0.0.0.0

# Number of Uvicorn workers for production
# In development, always runs with 1 worker regardless of this setting
APP_WORKERS=4

# Application name
APP_NAME=Request System

# ============================================================================
# Database
# ============================================================================

# Database connection URL
# SQLite: sqlite:///./requests.db  (relative path)
# SQLite: sqlite:////tmp/db.sqlite3  (absolute path)
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./requests.db

# Database connection pool size
DATABASE_POOL_SIZE=10

# Log SQL queries (development only)
DATABASE_ECHO_SQL=false

# ============================================================================
# API Configuration
# ============================================================================

# API endpoint prefix
API_PREFIX=/api

# API title for documentation
API_TITLE=Request System API

# API version
API_VERSION=1.1.0

# CORS allowed origins
# Use * for all origins, or comma-separated list: https://example.com,https://app.example.com
API_CORS_ORIGINS=*

# Swagger UI documentation path
API_DOCS_URL=/docs

# ReDoc documentation path
API_REDOC_URL=/redoc

# OpenAPI schema path
API_OPENAPI_URL=/openapi.json

# ============================================================================
# Health Check
# ============================================================================

# Health check interval (seconds) - how often Docker/K8s checks health
# Default: 30 (Docker default)
HEALTH_CHECK_INTERVAL=30

# Health check timeout (seconds) - how long to wait for response
# Default: 10
HEALTH_CHECK_TIMEOUT=10

# Health check start period (seconds) - grace period before first check
# Default: 5 (give app time to start)
HEALTH_CHECK_START_PERIOD=5

# Health check retries - how many failures before marking unhealthy
# Default: 3
HEALTH_CHECK_RETRIES=3

# ============================================================================
# Logging
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ============================================================================
# Examples for different environments
# ============================================================================

# DEVELOPMENT ENVIRONMENT:
# APP_ENV=development
# APP_DEBUG=true
# APP_PORT=8000
# APP_WORKERS=1
# DATABASE_URL=sqlite:///./requests-dev.db
# DATABASE_ECHO_SQL=true
# LOG_LEVEL=DEBUG

# STAGING ENVIRONMENT:
# APP_ENV=staging
# APP_DEBUG=false
# APP_PORT=8000
# APP_WORKERS=2
# DATABASE_URL=postgresql://user:pass@staging-db:5432/requests_staging
# DATABASE_ECHO_SQL=false
# LOG_LEVEL=INFO

# PRODUCTION ENVIRONMENT:
# APP_ENV=production
# APP_DEBUG=false
# APP_PORT=8000
# APP_WORKERS=8
# DATABASE_URL=postgresql://user:pass@prod-db:5432/requests_prod
# DATABASE_ECHO_SQL=false
# LOG_LEVEL=WARNING
# API_CORS_ORIGINS=https://app.example.com,https://api.example.com
