# Docker Compose Environment Configuration
# Copy to .env.docker and configure for your environment

# ============================================================================
# Application Configuration
# ============================================================================
APP_ENV=development              # development, staging, production
APP_DEBUG=true                   # Enable debug mode (false in production)
APP_PORT=8000                    # API server port
APP_WORKERS=4                    # Number of workers (production only)
APP_NAME=Request System          # Application name

# ============================================================================
# Database Configuration (PostgreSQL in compose)
# ============================================================================

# PostgreSQL Connection Parameters
DB_USER=postgres                 # Database user
DB_PASSWORD=postgres             # Database password (change in production!)
DB_NAME=requests_db              # Database name
DB_PORT=5432                     # PostgreSQL port

# Full DATABASE_URL for SQLite (development):
# DATABASE_URL=sqlite:///./requests.db

# Full DATABASE_URL for PostgreSQL (production):
# Constructed as: postgresql://DB_USER:DB_PASSWORD@db:DB_PORT/DB_NAME
DATABASE_URL=postgresql://postgres:postgres@db:5432/requests_db

# Database Connection Pool
DATABASE_POOL_SIZE=10            # Connection pool size
DATABASE_ECHO_SQL=false          # Log SQL queries (true for debugging)

# ============================================================================
# Redis Cache Configuration (Optional)
# ============================================================================
REDIS_URL=redis://cache:6379/0  # Redis connection URL
REDIS_PORT=6379                  # Redis port
REDIS_MAX_MEMORY=256mb           # Maximum memory (development)
                                 # Use 512mb or more in production

# ============================================================================
# API Configuration
# ============================================================================
API_PREFIX=/api                  # API route prefix
API_TITLE=Request System API     # API title for documentation
API_VERSION=1.1.0                # API version
API_CORS_ORIGINS=*               # CORS allowed origins (restrict in production)

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO                   # Log level: DEBUG, INFO, WARNING, ERROR
                                 # Use WARNING or ERROR in production

# ============================================================================
# pgAdmin Configuration (Development Only)
# ============================================================================
PGADMIN_EMAIL=admin@example.com  # pgAdmin login email
PGADMIN_PASSWORD=admin           # pgAdmin password (change if exposing!)
PGADMIN_PORT=5050                # pgAdmin web UI port

# ============================================================================
# Notes
# ============================================================================
# 1. DEVELOPMENT: Uses SQLite, no PostgreSQL needed
#    docker-compose up -d
#
# 2. DEVELOPMENT WITH DATABASE TOOLS: PostgreSQL + pgAdmin
#    docker-compose --profile dev up -d
#
# 3. PRODUCTION: PostgreSQL + Redis
#    docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#    Make sure to set strong DB_PASSWORD!
#
# 4. Environment variables are loaded from:
#    a) docker-compose .env file (this file)
#    b) System environment variables (override .env)
#    c) docker-compose environment: section (highest priority)
